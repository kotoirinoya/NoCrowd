# Vercel Dashboard の Storage (Postgres / Neon) から取得した接続文字列
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWTの署名に使うランダムな長い文字列（openssl rand -hex 32 などで生成）
JWT_SECRET="replace-with-a-long-random-string"

# Vercel Dashboard の Storage → Blob から作成したストアの Read/Write トークン
# （投稿写真・プロフィール画像のアップロードに使用）
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"
